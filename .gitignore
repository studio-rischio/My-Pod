# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Anchored to the repo root on purpose. Unanchored, these match at any depth —
# `examples/` was silently excluding core/libgpod/bindings/python/examples/,
# whose Makefile.am is named in libgpod's configure.ac, so a fresh clone failed
# to configure.
/examples/
/agent_space/
/build/
# Cross-compiled output. ARCH=x86_64 ./build.sh uses its own derived-data
# tree so both architectures can be built without clobbering each other.
/build-*/
.DS_Store
*~lock~*

# Superseded by core/libgpod. ipod-tools is its own repo
# (github.com/jbartolozzi/ipod-tools) and nothing here references it any more;
# ignored so a stray `git add -A` can't commit it as an embedded repo.
/ipod-tools/

# Vendored libgpod — the source is committed, the autotools build output is not.
# Regenerate with ./Scripts/build-libgpod.sh (clean with `… clean`).
core/libgpod/**/.libs/
core/libgpod/**/.deps/
core/libgpod/**/*.o
core/libgpod/**/*.lo
core/libgpod/**/*.la
core/libgpod/**/*.a
core/libgpod/**/Makefile
core/libgpod/**/Makefile.in
core/libgpod/**/stamp-h1
core/libgpod/aclocal.m4
core/libgpod/autom4te.cache/
core/libgpod/config.guess
core/libgpod/config.h
core/libgpod/config.h.in
core/libgpod/config.log
core/libgpod/config.status
core/libgpod/config.sub
core/libgpod/configure
core/libgpod/depcomp
core/libgpod/install-sh
core/libgpod/libtool
core/libgpod/ltmain.sh
core/libgpod/missing
core/libgpod/compile
core/libgpod/test-driver
core/libgpod/libgpod-1.0.pc
core/libgpod/po/*.gmo
core/libgpod/po/*.mo
core/libgpod/po/POTFILES
core/libgpod/po/stamp-it

# Full-resolution screenshot originals. The repo ships the resized .webp
# versions; these are kept locally so a re-encode doesn't mean re-shooting.
/docs/screenshots/_originals/

# Release artifacts, built by ./Scripts/bundle-app.sh + ditto. One per
# architecture, so match the whole family rather than a single arch suffix.
/My-Pod-*.zip

# Per-architecture libgpod archives and the staged x86_64 Homebrew libraries.
# Both are build products of Scripts/build-libgpod.sh and
# Scripts/fetch-intel-deps.sh, reproducible from a clean checkout.
Vendor/libgpod-arch/
Vendor/intel-deps/
